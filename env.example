# ==============================================================================
# Environment Configuration Template for Rahmani Islamic Center & Wa Raast Education System
# Copy this file to '.env' for local development or enter these in your Vercel Project Settings.
# ==============================================================================

# Database Connection URL:
# For local development with SQLite:
DATABASE_URL="file:./dev.db"

# For production deployment with PostgreSQL / Supabase / Neon:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres?sslmode=require"

# JWT Secret for Admin Authentication (Generate a strong 32+ character random string):
JWT_SECRET="replace-with-a-very-strong-and-secure-random-jwt-secret-key-32-chars-minimum"

# Public Site URL:
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Initial Admin Credentials (used during database seeding):
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="YourStrongAdminPassword2026!"
